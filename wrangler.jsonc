{
  // Stage-2 PREVIEW worker. Production stays on Vercel until the migration is finished.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilmoo-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Neon trial database through Hyperdrive (step 8). Query caching is turned
  // off on this config: cached reads could show a stale exam or grade.
  // Local dev reads the direct (non-pooler) connection string from .env:
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4f0f384a2ed04edf9bfc048483cbfd48" }]
}
