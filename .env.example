# ============================================================
# EduQuest — Environment Variables
# Copy to .env.local for local dev. In production (Vercel),
# set these in Project Settings → Environment Variables.
# NEVER commit real values — .env* is gitignored.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Project URL + anon key are public (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS — SERVER ONLY, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ─────────────────────────────────────────────────
# Used to build invitation links. In production set this to your
# deployed domain (e.g. https://eduquest.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ────────────────────────────────────────────
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
# Cohere — free trial key (no card required), OpenAI-compatible endpoint.
COHERE_API_KEY=your-cohere-key
# OpenRouter — gateway to many free models (incl. vision fallback).
OPENROUTER_API_KEY=your-openrouter-key

# ── Live proctoring (LiveKit) ───────────────────────────────
# Real-time exam monitoring: students publish camera+mic, the teacher
# watches/listens live. Create a free project at cloud.livekit.io → the
# project gives you a wss:// URL, an API key and an API secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# ── Email (Resend) ──────────────────────────────────────────
# Get your API key from resend.com → API Keys.
RESEND_API_KEY=your-resend-api-key

# Verified sender address for invitation emails.
# Must match a domain you've verified in Resend.
# Without this, emails only deliver to the Resend account owner (sandbox mode).
EMAIL_FROM=EduQuest <noreply@yourdomain.com>

# ── Feature flags (optional) ────────────────────────────────
# (NEXT_PUBLIC_SERVER_PROCTORING was removed 2026-09-13 — proctoring now runs
#  entirely on the student's device; there is no server-side vision layer.)

# Institutional mailbox linking (a dedicated OAuth client — NOT the Supabase sign-in client)
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_TOKEN_ENCRYPTION_KEY=

# ── Proctoring evidence snapshots (NOT stored in Supabase) ──
# Snapshots are visible to the exam teacher for 30 hours, then deleted for good.
# Option 1 (current): Cloudflare Workers KV — free plan, Cloudflare deletes each
# snapshot itself at 30 h. Token: account API token, "Workers KV Storage: Edit" only.
EVIDENCE_KV_ACCOUNT_ID=
EVIDENCE_KV_NAMESPACE_ID=
EVIDENCE_KV_API_TOKEN=
# Option 2: any S3-compatible bucket (e.g. Cloudflare R2). Used only when KV is unset.
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_REGION=auto
# Only for option 2: the hourly cleanup (.github/workflows/evidence-cleanup.yml).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Google sign-in buttons on /login and /join (hidden until Google verification). "on" shows them; rebuild after changing.
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Cloudflare Turnstile (CAPTCHA on sign-in, join, reset, password change). Empty = off.
# Order on go-live: deploy with both keys set, THEN turn on Supabase Dashboard →
# Authentication → Bot and Abuse Protection → CAPTCHA (Turnstile, same secret).
# Local testing: Cloudflare's public test keys — site 1x00000000000000000000AA
# (always passes), secret 1x0000000000000000000000000000000AA. Rebuild after changing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
