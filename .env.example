# ============================================================
# EduQuest — Environment Variables
# Copy to .env.local for local dev. In production (Vercel),
# set these in Project Settings → Environment Variables.
# NEVER commit real values — .env* is gitignored.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Project URL + anon key are public (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key bypasses RLS — SERVER ONLY, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ─────────────────────────────────────────────────
# Used to build invitation links. In production set this to your
# deployed domain (e.g. https://eduquest.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI providers ────────────────────────────────────────────
GROQ_API_KEY=your-groq-key
GEMINI_API_KEY=your-gemini-key
# Cerebras — free tier, same Llama 3.3 70B as Groq with a much larger daily quota.
CEREBRAS_API_KEY=your-cerebras-key
# OpenRouter — gateway to many free models (incl. vision fallback).
OPENROUTER_API_KEY=your-openrouter-key

# ── Email (Resend) ──────────────────────────────────────────
# Get your API key from resend.com → API Keys.
RESEND_API_KEY=your-resend-api-key

# Verified sender address for invitation emails.
# Must match a domain you've verified in Resend.
# Without this, emails only deliver to the Resend account owner (sandbox mode).
EMAIL_FROM=EduQuest <noreply@yourdomain.com>

# ── Feature flags (optional) ────────────────────────────────
# Set to "true" to enable the Gemini Vision server-side proctoring layer.
NEXT_PUBLIC_SERVER_PROCTORING=false
